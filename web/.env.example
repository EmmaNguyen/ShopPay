# Copy to web/.env.local

# PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Public client id for PayPal React SDK (same as PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional: set OPENAI_AGENT=true to use LLM tools (default is deterministic demo agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_AGENT=false

# If true, checkout uses Simulate PayPal (also when PayPal env vars are missing)
DEMO_MODE=false

# Fares — mock OTA first (Thanksgiving JSON); set USE_MOCK_OTA=false to skip
USE_MOCK_OTA=true
FARE_PROVIDERS=mock,duffel,amadeus

# Duffel (https://duffel.com/sign-up) — recommended self-serve OTA API
DUFFEL_ACCESS_TOKEN=

# Amadeus Self-Service (https://developers.amadeus.com/)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Public API catalog: GET /api/demo/ota-sources (see web/data/ota-public-apis.json)
# Optional departure for DFW→MCI/OMA search (YYYY-MM-DD)
DEMO_DEPARTURE_DATE=2026-11-26

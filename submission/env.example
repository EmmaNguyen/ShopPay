# Copy to web/.env.local

# PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Public client id for PayPal React SDK (same as PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional: enables LLM tool orchestration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# If true and PayPal creds missing, checkout shows simulated success (labeled in UI)
DEMO_MODE=false
